{%- liquid
  assign top = product.metafields.custom.notes_top.value
  assign heart = product.metafields.custom.notes_heart.value
  assign base = product.metafields.custom.notes_base.value
-%}

{%- if top.size > 0 or heart.size > 0 or base.size > 0 -%}
  <section class="section section--alt note-pyramid">
    <div class="container">
      <header class="note-pyramid__head">
        <p class="t-eyebrow eyebrow-rule">{{ 'products.pyramid.heading' | t }}</p>
      </header>

      <div class="note-pyramid__tiers">
        {%- if top.size > 0 -%}
          <div class="note-tier note-tier--top">
            <p class="t-eyebrow note-tier__label">{{ 'products.pyramid.top' | t }}</p>
            <ul class="note-tier__list">
              {%- for note in top -%}<li>{{ note }}</li>{%- endfor -%}
            </ul>
          </div>
          {%- if heart.size > 0 or base.size > 0 -%}<hr class="hairline note-tier__rule">{%- endif -%}
        {%- endif -%}

        {%- if heart.size > 0 -%}
          <div class="note-tier note-tier--heart">
            <p class="t-eyebrow note-tier__label">{{ 'products.pyramid.heart' | t }}</p>
            <ul class="note-tier__list">
              {%- for note in heart -%}<li>{{ note }}</li>{%- endfor -%}
            </ul>
          </div>
          {%- if base.size > 0 -%}<hr class="hairline note-tier__rule">{%- endif -%}
        {%- endif -%}

        {%- if base.size > 0 -%}
          <div class="note-tier note-tier--base">
            <p class="t-eyebrow note-tier__label">{{ 'products.pyramid.base' | t }}</p>
            <ul class="note-tier__list">
              {%- for note in base -%}<li>{{ note }}</li>{%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

<style>
  .note-pyramid__head { text-align: center; margin-bottom: var(--space-6); }

  .note-pyramid__tiers { max-width: 720px; margin-inline: auto; text-align: center; }

  .note-tier { padding-block: var(--space-5); }

  .note-tier__label { color: var(--smoke); margin-bottom: var(--space-3); }

  .note-tier__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    justify-content: center;
    font-family: var(--font-display);
    line-height: 1.1;
  }

  .note-tier--top   .note-tier__list { font-size: clamp(22px, 2.4vw, 32px); }
  .note-tier--heart .note-tier__list { font-size: clamp(28px, 3vw, 44px); }
  .note-tier--base  .note-tier__list { font-size: clamp(34px, 3.6vw, 56px); }

  .note-tier__rule { border-color: var(--hairline); max-width: 240px; margin-inline: auto; opacity: 0.6; }
</style>

{% schema %}
{
  "name": "Note pyramid",
  "settings": []
}
{% endschema %}
