<div data-predictive-results>
  {%- if predictive_search.performed -%}
    {%- if predictive_search.resources.products.size > 0 -%}
      <ul class="predictive-results">
        {%- for product in predictive_search.resources.products limit: 6 -%}
          <li class="predictive-result">
            <a href="{{ product.url }}" class="predictive-result__link">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 120 }}" width="60" height="75" alt="{{ product.featured_image.alt | escape }}" loading="lazy">
              {%- endif -%}
              <span class="predictive-result__body">
                <span class="predictive-result__title">{{ product.title }}</span>
                {%- if settings.predictive_search_show_price -%}
                  <span class="t-small">{{ product.price | money }}</span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="t-small">{{ 'general.search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- endif -%}
  {%- endif -%}
</div>

<style>
  .predictive-results { list-style: none; margin: 0; padding: 0; }
  .predictive-result { border-bottom: var(--hairline-w) solid var(--hairline); }
  .predictive-result__link { display: flex; gap: var(--space-3); padding: var(--space-3) 0; align-items: center; }
  .predictive-result__body { display: flex; flex-direction: column; gap: 2px; }
  .predictive-result__title { font-family: var(--font-display); font-size: 18px; }
</style>

{% schema %}
{
  "name": "Predictive search",
  "settings": []
}
{% endschema %}
