<section class="section">
  <div class="container">
    <header class="collection-page__head">
      <p class="t-eyebrow">{{ 'blogs.index.eyebrow' | t }}</p>
      <h1 class="t-h1">{{ blog.title }}</h1>
      <p class="t-small">{{ 'blogs.index.subtitle' | t }}</p>
    </header>

    {%- paginate blog.articles by section.settings.articles_per_page -%}
      <ul class="journal-index">
        {%- for article in blog.articles -%}
          <li class="journal-index__item">
            <a href="{{ article.url }}" class="journal-index__link">
              <div class="journal-index__media">
                {%- if article.image -%}
                  <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" width="600" height="450">
                {%- endif -%}
              </div>
              <div class="journal-index__body">
                {%- if article.tags.size > 0 -%}<p class="t-eyebrow">{{ article.tags | first }}</p>{%- endif -%}
                <h2 class="t-display journal-index__title">{{ article.title }}</h2>
                <p class="t-small">{{ article.published_at | date: '%B %Y' }} · {{ article.author }}</p>
                {%- if article.excerpt != blank -%}
                  <div class="journal-index__excerpt">{{ article.excerpt | strip_html | truncatewords: 30 }}</div>
                {%- endif -%}
                <span class="btn--inline">{{ 'blogs.article.read_more' | t }} {% render 'icon', name: 'arrow-right' %}</span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

<style>
  .journal-index { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-7); }

  .journal-index__link { display: grid; gap: var(--space-4); align-items: center; color: inherit; }

  @media (min-width: 750px) {
    .journal-index__link { grid-template-columns: 1fr 1fr; gap: var(--space-6); }
    .journal-index__item:nth-child(even) .journal-index__link > :first-child { order: 2; }
  }

  .journal-index__media img { aspect-ratio: 4 / 3; width: 100%; object-fit: cover; transition: transform var(--transition-slow); }

  .journal-index__link:hover .journal-index__media img { transform: scale(1.03); }

  .journal-index__title { font-size: clamp(28px, 3vw, 44px); line-height: 1.1; margin-block: var(--space-2); }

  .journal-index__excerpt { color: var(--smoke); font-size: 16px; line-height: var(--lh-body); margin-block: var(--space-3); }
</style>

{% schema %}
{
  "name": "Blog index",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "Articles per page",
      "default": 9
    }
  ]
}
{% endschema %}
