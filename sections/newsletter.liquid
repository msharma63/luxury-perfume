<section class="section section--ink newsletter-section">
  <div class="container newsletter-section__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="t-eyebrow newsletter-section__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="t-h2 newsletter-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="newsletter-section__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {% form 'customer', class: 'newsletter-section__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="MainNewsletterEmail" class="visually-hidden">{{ 'general.newsletter_form.newsletter_email' | t }}</label>
      <div class="field--inline newsletter-section__field">
        <input
          type="email"
          id="MainNewsletterEmail"
          name="contact[email]"
          class="field__input"
          placeholder="{{ 'general.newsletter_form.newsletter_email' | t }}"
          required>
        <button type="submit" class="btn--inline">
          {{ 'general.newsletter_form.submit' | t }}
        </button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="t-small newsletter-section__confirm">{{ 'general.newsletter_form.confirmation' | t }}</p>
      {%- endif -%}
    {% endform %}
  </div>
</section>

<style>
  .newsletter-section__inner { text-align: center; max-width: 640px; margin-inline: auto; }

  .newsletter-section__eyebrow { color: var(--paper); opacity: 0.8; }

  .newsletter-section__heading { color: var(--paper); margin-block: var(--space-3) var(--space-3); }

  .newsletter-section__sub { color: var(--paper); opacity: 0.8; margin-bottom: var(--space-5); }

  .newsletter-section__field { color: var(--paper); margin-top: var(--space-3); }

  .newsletter-section__field .field__input { color: var(--paper); }

  .newsletter-section__field .field__input::placeholder { color: rgba(250, 247, 242, 0.6); }

  .newsletter-section__field .btn--inline { color: var(--paper); }

  .newsletter-section__confirm { color: var(--paper); margin-top: var(--space-3); }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Correspondence" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Letters from the atelier" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Occasional notes — new compositions, ingredient stories, private launches." }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
