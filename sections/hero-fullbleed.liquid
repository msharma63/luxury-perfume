<section class="hero" data-section-id="{{ section.id }}">
  <div class="hero__media">
    {%- if section.settings.image_mobile -%}
      <picture>
        <source media="(min-width: 750px)" srcset="
          {%- if section.settings.image -%}
            {{ section.settings.image | image_url: width: 1200 }} 1200w,
            {{ section.settings.image | image_url: width: 1800 }} 1800w,
            {{ section.settings.image | image_url: width: 2400 }} 2400w
          {%- endif -%}">
        <img
          src="{{ section.settings.image_mobile | image_url: width: 900 }}"
          alt="{{ section.settings.image_mobile.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image_mobile.width }}"
          height="{{ section.settings.image_mobile.height }}"
          fetchpriority="high"
          loading="eager">
      </picture>
    {%- elsif section.settings.image -%}
      <img
        src="{{ section.settings.image | image_url: width: 2400 }}"
        srcset="{{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1800 }} 1800w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        fetchpriority="high"
        loading="eager">
    {%- else -%}
      <div class="hero__placeholder"></div>
    {%- endif -%}
  </div>

  <div class="hero__overlay">
    <div class="container hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="t-eyebrow hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="t-hero hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.cta_text != blank and section.settings.cta_link != blank -%}
        <a href="{{ section.settings.cta_link }}" class="btn--inline hero__cta">
          {{ section.settings.cta_text }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .hero { position: relative; }

  .hero__media {
    aspect-ratio: 4 / 5;
    background: var(--paper-alt);
    overflow: hidden;
  }

  @media (min-width: 750px) {
    .hero__media { aspect-ratio: 16 / 9; }
  }

  .hero__media img,
  .hero__placeholder { width: 100%; height: 100%; object-fit: cover; display: block; }

  .hero__placeholder { background: var(--paper-alt); }

  .hero__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding-block: var(--space-6);
    color: {{ section.settings.text_color }};
  }

  .hero__content { max-width: 720px; }

  .hero__eyebrow { color: inherit; opacity: 0.85; margin-bottom: var(--space-4); }

  .hero__heading { color: inherit; margin: 0 0 var(--space-4); }

  .hero__sub { font-size: 18px; max-width: 480px; margin: 0 0 var(--space-5); opacity: 0.9; }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: inherit;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: var(--ls-button);
    padding-bottom: 6px;
    border-bottom: 1px solid currentColor;
  }
</style>

{% schema %}
{
  "name": "Hero — full-bleed",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image (16:9 recommended)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (4:5 recommended)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The new fragrance"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Vélin Noir"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "An accord of oud, iris and bitter orange — composed for the long evening."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Discover"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#FAF7F2"
    }
  ],
  "presets": [
    { "name": "Hero — full-bleed" }
  ]
}
{% endschema %}
