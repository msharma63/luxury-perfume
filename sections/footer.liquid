<footer class="footer section--ink" role="contentinfo">
  {%- if section.settings.show_newsletter -%}
    <div class="container footer__newsletter">
      <p class="t-eyebrow eyebrow-rule" style="color:var(--paper);">{{ section.settings.newsletter_eyebrow }}</p>
      <h2 class="t-h2 footer__newsletter-title">{{ section.settings.newsletter_title }}</h2>
      {% form 'customer', class: 'footer__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="NewsletterEmail" class="visually-hidden">{{ 'general.newsletter_form.newsletter_email' | t }}</label>
        <div class="field--inline" style="color:var(--paper); max-width:520px; margin-inline:auto;">
          <input
            type="email"
            id="NewsletterEmail"
            name="contact[email]"
            class="field__input"
            placeholder="{{ 'general.newsletter_form.newsletter_email' | t }}"
            required
            style="color:var(--paper);"
          >
          <button type="submit" class="btn btn--inline" style="color:var(--paper);">
            {{ 'general.newsletter_form.submit' | t }}
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="t-small" style="color:var(--paper); margin-top:var(--space-3);">
            {{ 'general.newsletter_form.confirmation' | t }}
          </p>
        {%- endif -%}
      {% endform %}
    </div>

    <hr class="hairline footer__rule">
  {%- endif -%}

  <div class="container footer__cols">
    <div class="footer__col footer__col--brand">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="200" height="{{ 200 | times: settings.logo.height | divided_by: settings.logo.width }}" loading="lazy">
      {%- else -%}
        <p class="t-display" style="font-size:28px;">{{ shop.name }}</p>
      {%- endif -%}
      {%- if section.settings.signature != blank -%}
        <p class="t-small footer__signature">{{ section.settings.signature }}</p>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div class="footer__col" {{ block.shopify_attributes }}>
        {%- if block.type == 'menu' -%}
          <p class="t-eyebrow footer__col-title">{{ block.settings.heading }}</p>
          <ul>
            {%- for link in linklists[block.settings.menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- elsif block.type == 'social' -%}
          <p class="t-eyebrow footer__col-title">{{ block.settings.heading }}</p>
          <ul>
            {%- if settings.social_instagram_link != blank -%}
              <li><a href="{{ settings.social_instagram_link }}">{{ 'general.social.links.instagram' | t }}</a></li>
            {%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}
              <li><a href="{{ settings.social_pinterest_link }}">{{ 'general.social.links.pinterest' | t }}</a></li>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <li><a href="{{ settings.social_tiktok_link }}">{{ 'general.social.links.tiktok' | t }}</a></li>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <li><a href="{{ settings.social_youtube_link }}">{{ 'general.social.links.youtube' | t }}</a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <hr class="hairline footer__rule">

  <div class="container footer__bottom">
    <p class="t-small">© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.legal }}</p>
    <ul class="footer__legal-links">
      {%- if shop.privacy_policy -%}<li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>{%- endif -%}
      {%- if shop.terms_of_service -%}<li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>{%- endif -%}
      {%- if shop.shipping_policy -%}<li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>{%- endif -%}
      {%- if shop.refund_policy -%}<li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>{%- endif -%}
    </ul>
  </div>
</footer>

<style>
  .footer { padding-block: var(--space-7); }

  .footer__newsletter { text-align: center; padding-bottom: var(--space-6); }

  .footer__newsletter-title { margin-block: var(--space-3) var(--space-5); color: var(--paper); }

  .footer__rule { border-color: rgba(228, 223, 212, 0.18); margin-block: var(--space-5); }

  .footer__cols {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 750px) {
    .footer__cols { grid-template-columns: 2fr 1fr 1fr 1fr; }
  }

  .footer__col-title { color: var(--paper); margin-bottom: var(--space-3); opacity: 0.7; }

  .footer__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }

  .footer__col a { font-size: 14px; opacity: 0.85; }

  .footer__col a:hover { opacity: 1; color: var(--champagne); }

  .footer__signature { margin-top: var(--space-3); max-width: 320px; opacity: 0.7; }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    color: var(--paper);
    opacity: 0.7;
  }

  .footer__legal-links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--type-small);
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_eyebrow",
      "label": "Newsletter eyebrow",
      "default": "Correspondence"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter title",
      "default": "Letters from the atelier"
    },
    {
      "type": "textarea",
      "id": "signature",
      "label": "Brand signature",
      "default": "Composed and bottled by hand. Paris."
    },
    {
      "type": "text",
      "id": "legal",
      "label": "Legal line",
      "default": "All rights reserved."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "The House" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "social",
      "name": "Social column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Follow" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "The House" } },
      { "type": "menu", "settings": { "heading": "Service" } },
      { "type": "social", "settings": { "heading": "Follow" } }
    ]
  }
}
{% endschema %}
