<section class="section section--ink cta-band">
  <div class="container cta-band__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="t-h2 cta-band__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="cta-band__body">{{ section.settings.body }}</p>
    {%- endif -%}
    {%- if section.settings.cta_text != blank -%}
      <a href="{{ section.settings.cta_link }}" class="btn btn--ghost cta-band__cta">{{ section.settings.cta_text }}</a>
    {%- endif -%}
  </div>
</section>

<style>
  .cta-band { color: var(--paper); }
  .cta-band__inner { text-align: center; max-width: 640px; margin-inline: auto; }
  .cta-band__heading { color: var(--paper); margin-bottom: var(--space-3); }
  .cta-band__body { color: var(--paper); opacity: 0.85; margin-bottom: var(--space-5); font-size: 17px; line-height: var(--lh-body); }
  .cta-band__cta { color: var(--paper); border-color: var(--paper); }
  .cta-band__cta:hover { background: var(--paper); color: var(--ink); border-color: var(--paper); }
</style>

{% schema %}
{
  "name": "CTA band",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visit the atelier" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Private appointments held in our 6th arrondissement studio. By correspondence only." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Request an appointment" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "presets": [{ "name": "CTA band" }]
}
{% endschema %}
