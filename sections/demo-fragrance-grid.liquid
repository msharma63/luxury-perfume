<section class="demo-grid section">
  <div class="container">
    <header class="demo-grid__head">
      <p class="t-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="t-h2 demo-grid__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="demo-grid__body t-small">{{ section.settings.body }}</p>
      {%- endif -%}
    </header>

    {%- assign names = "Cuir Bohème|Néroli Sauvage|Bois de Lune|Iris Pourpre|Tubéreuse Noire|Ambre Soleil|Vétiver Brut|Rose Indigo|Oud Sacré|Jasmin d’Hiver|Patchouli Velours|Bergamote Sel|Santal Cendré|Mousse de Pierre|Géranium Or|Iris Cendré|Cassis Voyage|Encens Blanc|Magnolia Suède|Cèdre Pluie|Figue Lointaine|Datura Minuit|Mimosa Cuir|Vanille Tabac|Lys d’Eau|Poivre Rose|Pamplemousse Brûlé|Lavande Fossile|Myrrhe Doré|Hêtre Sauvage" | split: '|' -%}

    {%- assign families = 'Oriental|Fresh|Woody|Floral|Floral|Oriental|Woody|Floral|Oriental|Floral|Woody|Fresh|Woody|Woody|Floral|Floral|Fresh|Oriental|Floral|Woody|Fresh|Oriental|Floral|Oriental|Floral|Fresh|Fresh|Floral|Oriental|Woody' | split: '|' -%}

    {%- assign notes = 'Leather · Oud · Saffron|Neroli · Sea salt · Bergamot|Cedar · Moonflower · Galbanum|Iris · Violet · Heliotrope|Tuberose · Coffee · Vanilla|Amber · Sandalwood · Resin|Vetiver · Birch tar · Smoke|Rose · Plum · Patchouli|Oud · Frankincense · Rose|Jasmine · Cardamom · Vetiver|Patchouli · Cocoa · Suede|Bergamot · Sea salt · Coriander|Sandalwood · Ash · Iris|Lichen · Stone · Hay|Geranium · Honey · Gold leaf|Iris · Carrot seed · Smoke|Blackcurrant · Pine · Wet leaves|Frankincense · White flowers · Myrrh|Magnolia · Suede · Vanilla|Cedar · Petrichor · Galbanum|Fig · Coconut · Pistachio|Datura · Tobacco · Civet|Mimosa · Leather · Almond|Vanilla · Tobacco · Tonka|Water lily · Cucumber · White tea|Pink pepper · Rose · Geranium|Pink grapefruit · Caramel · Smoke|Lavender · Amber · Tobacco|Myrrh · Gold · Saffron|Beech · Resin · Forest floor' | split: '|' -%}

    {%- assign prices = '320|210|290|340|380|260|240|310|420|295|280|195|330|365|270|355|225|395|305|285|215|375|300|245|205|255|235|275|410|320' | split: '|' -%}

    {%- assign sizes_ml = '50|100|50|100|50|100|100|50|50|100|50|100|50|100|50|50|100|50|50|100|50|50|50|100|100|50|100|50|50|100' | split: '|' -%}

    <ul class="demo-grid__list">
      {%- for name in names -%}
        {%- assign i = forloop.index0 -%}
        {%- assign family = families[i] -%}
        {%- assign tone_class = family | downcase | prepend: 'demo-card--' -%}
        <li class="demo-card {{ tone_class }}">
          <a href="#" class="demo-card__link" aria-label="{{ name }} — preview only">
            <div class="demo-card__media">
              <svg class="demo-card__bottle" viewBox="0 0 120 160" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="48" y="6" width="24" height="14" rx="1" class="demo-card__cap"/>
                <rect x="52" y="20" width="16" height="10" class="demo-card__neck"/>
                <rect x="22" y="30" width="76" height="118" rx="4" class="demo-card__body"/>
                <rect x="34" y="64" width="52" height="56" class="demo-card__label"/>
                <text x="60" y="88" text-anchor="middle" class="demo-card__label-mark">M</text>
                <text x="60" y="104" text-anchor="middle" class="demo-card__label-name">{{ name | upcase }}</text>
              </svg>
            </div>
            <div class="demo-card__body-text">
              <p class="t-eyebrow demo-card__family">{{ family }}</p>
              <h3 class="demo-card__name">{{ name }}</h3>
              <p class="demo-card__notes">{{ notes[i] }}</p>
              <div class="demo-card__meta">
                <span class="demo-card__size">{{ sizes_ml[i] }} ml · Eau de Parfum</span>
                <span class="demo-card__price">£{{ prices[i] }}</span>
              </div>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .demo-grid {
    padding-block: var(--section-y);
    background: linear-gradient(180deg, transparent, var(--paper-alt) 60%, transparent);
  }

  .demo-grid__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: center;
  }

  .demo-grid__heading { margin: 0; }
  .demo-grid__body { color: var(--smoke); max-width: 520px; }

  .demo-grid__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5) var(--space-4);
  }

  @media (min-width: 750px) {
    .demo-grid__list { grid-template-columns: repeat(3, 1fr); gap: var(--space-6) var(--space-5); }
  }
  @media (min-width: 990px) {
    .demo-grid__list { grid-template-columns: repeat(5, 1fr); }
  }

  .demo-card { margin: 0; }
  .demo-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: inherit;
    cursor: pointer;
  }

  .demo-card__media {
    aspect-ratio: 3 / 4;
    background: var(--demo-card-bg, var(--paper-alt));
    display: grid;
    place-items: center;
    overflow: hidden;
    transition: transform var(--transition-slow);
  }
  .demo-card__link:hover .demo-card__media {
    transform: translateY(-4px);
  }

  .demo-card__bottle {
    width: 50%;
    height: auto;
    filter: drop-shadow(0 8px 20px rgba(14, 14, 12, 0.08));
  }
  .demo-card__cap { fill: var(--demo-card-glass-dark, #322a20); }
  .demo-card__neck { fill: var(--demo-card-glass-dark, #322a20); }
  .demo-card__body { fill: var(--demo-card-glass, #5a4a35); opacity: 0.92; }
  .demo-card__label { fill: var(--paper); opacity: 0.94; }
  .demo-card__label-mark {
    font-family: var(--font-display);
    font-size: 14px;
    fill: var(--ink);
    letter-spacing: 0;
  }
  .demo-card__label-name {
    font-family: var(--font-sans);
    font-size: 4.5px;
    fill: var(--ink);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .demo-card--floral {
    --demo-card-bg: #efe1e3;
    --demo-card-glass: #a26a72;
    --demo-card-glass-dark: #6e4147;
  }
  .demo-card--woody {
    --demo-card-bg: #e5dccb;
    --demo-card-glass: #6b5238;
    --demo-card-glass-dark: #3d2c1c;
  }
  .demo-card--oriental {
    --demo-card-bg: #ead7bf;
    --demo-card-glass: #8c5a2a;
    --demo-card-glass-dark: #4d2f10;
  }
  .demo-card--fresh {
    --demo-card-bg: #dde6e0;
    --demo-card-glass: #4f6f5e;
    --demo-card-glass-dark: #2c4538;
  }

  .demo-card__body-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .demo-card__family {
    color: var(--champagne-deep);
    margin: 0;
  }

  .demo-card__name {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: var(--lh-tight);
    margin: 0;
  }

  .demo-card__notes {
    font-size: 13px;
    color: var(--smoke);
    line-height: 1.6;
    margin: 0;
  }

  .demo-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: var(--hairline-w) solid var(--hairline);
    font-size: 12px;
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
  }
  .demo-card__size { color: var(--smoke); }
  .demo-card__price { color: var(--ink); font-weight: 500; }

  .demo-card__link:hover .demo-card__name { color: var(--champagne-deep); }
</style>

{% schema %}
{
  "name": "Demo fragrance grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thirty compositions"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Subheading",
      "default": "Hand-blended in small batches in Paris. Each composed around a single olfactory memory."
    }
  ],
  "presets": [
    { "name": "Demo fragrance grid" }
  ]
}
{% endschema %}
