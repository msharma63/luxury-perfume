<section class="section">
  <div class="container customer-page">
    <header class="customer-page__head">
      <p class="t-eyebrow">Account</p>
      <h1 class="t-h1">{{ 'customer.register.title' | t }}</h1>
    </header>

    {% form 'create_customer' %}
      {%- if form.errors -%}
        <div class="customer-page__errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <label class="field"><span class="field__label">{{ 'customer.register.first_name' | t }}</span>
        <input type="text" name="customer[first_name]" autocomplete="given-name" class="field__input"></label>
      <label class="field"><span class="field__label">{{ 'customer.register.last_name' | t }}</span>
        <input type="text" name="customer[last_name]" autocomplete="family-name" class="field__input"></label>
      <label class="field"><span class="field__label">{{ 'customer.register.email' | t }}</span>
        <input type="email" name="customer[email]" autocomplete="email" required class="field__input"></label>
      <label class="field"><span class="field__label">{{ 'customer.register.password' | t }}</span>
        <input type="password" name="customer[password]" autocomplete="new-password" required class="field__input"></label>

      <button type="submit" class="btn btn--full">{{ 'customer.register.submit' | t }}</button>

      <p class="t-small" style="text-align:center; margin-top:var(--space-3);">
        Already have an account? <a href="{{ routes.account_login_url }}" class="btn--inline">{{ 'customer.login_page.submit' | t }}</a>
      </p>
    {% endform %}
  </div>
</section>

<style>
  .customer-page { max-width: 480px; margin-inline: auto; display: grid; gap: var(--space-3); }
  .customer-page__head { text-align: center; padding-block: var(--space-5); }
</style>
