<section class="section">
  <div class="container account-page">
    <header class="collection-page__head">
      <p class="t-eyebrow">{{ 'customer.account.title' | t }}</p>
      <h1 class="t-h1">{{ customer.first_name | default: customer.email }}</h1>
      <p class="t-small">
        <a href="{{ routes.account_addresses_url }}" class="btn--inline">{{ 'customer.account.view_addresses' | t }}</a>
        ·
        <a href="{{ routes.account_logout_url }}" class="btn--inline">{{ 'customer.account.logout' | t }}</a>
      </p>
    </header>

    <h2 class="t-h3" style="margin-bottom:var(--space-4);">{{ 'customer.orders.title' | t }}</h2>

    {%- if customer.orders.size > 0 -%}
      <table class="orders-table">
        <thead>
          <tr>
            <th>{{ 'customer.orders.order_number' | t }}</th>
            <th>{{ 'customer.orders.date' | t }}</th>
            <th>{{ 'customer.orders.payment_status' | t }}</th>
            <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
            <th>{{ 'customer.orders.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td><a href="{{ order.customer_url }}" class="btn--inline">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: '%b %-d, %Y' }}</td>
              <td>{{ order.financial_status_label }}</td>
              <td>{{ order.fulfillment_status_label }}</td>
              <td>{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- else -%}
      <p class="t-small">{{ 'customer.account.no_orders' | t }}</p>
    {%- endif -%}
  </div>
</section>

<style>
  .account-page { max-width: 880px; margin-inline: auto; }
  .orders-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .orders-table th, .orders-table td { padding: var(--space-3) 0; border-bottom: var(--hairline-w) solid var(--hairline); text-align: left; }
  .orders-table th { font-size: var(--type-eyebrow); text-transform: uppercase; letter-spacing: var(--ls-eyebrow); color: var(--smoke); font-weight: 500; }
</style>
