<section class="section section--alt family-tiles">
  <div class="container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="family-tiles__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="t-eyebrow eyebrow-rule">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="t-h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="grid grid--families">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="family-tile" {{ block.shopify_attributes }}>
          <div class="family-tile__media">
            {%- if block.settings.image -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                width="400"
                height="500"
                loading="lazy">
            {%- else -%}
              <div class="family-tile__placeholder"></div>
            {%- endif -%}
          </div>
          <div class="family-tile__body">
            <h3 class="t-display family-tile__title">{{ block.settings.title }}</h3>
            {%- if block.settings.description != blank -%}
              <p class="t-small">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .family-tiles__head { text-align: center; margin-bottom: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); align-items: center; }

  .family-tile { display: block; }

  .family-tile__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--paper);
  }

  .family-tile__media img,
  .family-tile__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .family-tile:hover .family-tile__media img { transform: scale(1.04); }

  .family-tile__body { text-align: center; padding-top: var(--space-3); }

  .family-tile__title { font-size: 28px; margin-bottom: var(--space-1); }
</style>

{% schema %}
{
  "name": "Fragrance families",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Olfactory families" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your accord" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Family",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Floral" },
        { "type": "text", "id": "description", "label": "Description", "default": "Iris, rose, jasmine — composed with restraint." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Fragrance families",
      "blocks": [
        { "type": "tile", "settings": { "title": "Floral", "description": "Iris, rose, jasmine — composed with restraint." } },
        { "type": "tile", "settings": { "title": "Woody", "description": "Cedar, vetiver, oud — grounded and slow." } },
        { "type": "tile", "settings": { "title": "Oriental", "description": "Amber, resin, spice — warmth as architecture." } },
        { "type": "tile", "settings": { "title": "Fresh", "description": "Bergamot, neroli, sea salt — the first hour of light." } }
      ]
    }
  ]
}
{% endschema %}
