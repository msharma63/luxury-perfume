<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }} — Coming soon</title>
    <link rel="canonical" href="{{ canonical_url }}">
    {% render 'meta-tags' %}
    {{ 'italiana-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'inter-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'inter-500.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'tokens.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'fonts.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="page-password">
    <main class="password" role="main">
      <div class="container password__inner">
        {%- if settings.logo != blank -%}
          <img src="{{ settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" width="160" height="{{ 160 | times: settings.logo.height | divided_by: settings.logo.width }}" loading="eager">
        {%- else -%}
          <p class="t-display password__wordmark">{{ shop.name }}</p>
        {%- endif -%}

        <h1 class="t-h1 password__heading">{{ shop.password_message | default: 'Opening soon' }}</h1>

        {% form 'storefront_password' %}
          <label class="field" style="max-width:360px; margin-inline:auto;">
            <span class="field__label">{{ 'general.password_page.login_form_password_label' | t }}</span>
            <input type="password" name="password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}" required class="field__input">
          </label>
          <button type="submit" class="btn">{{ 'general.password_page.login_form_submit' | t }}</button>
          {%- if form.errors -%}
            <p class="t-small" style="color:var(--error); margin-top:var(--space-3);">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {% endform %}

        <hr class="hairline" style="max-width:240px; margin:var(--space-6) auto;">

        <p class="t-eyebrow">{{ 'general.newsletter_form.newsletter_email' | t }}</p>
        {% form 'customer' %}
          <input type="hidden" name="contact[tags]" value="prospect,password-page">
          <div class="field--inline" style="max-width:360px; margin-inline:auto;">
            <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.newsletter_email' | t }}" required class="field__input">
            <button type="submit" class="btn--inline">{{ 'general.newsletter_form.submit' | t }}</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="t-small" style="margin-top:var(--space-3);">{{ 'general.password_page.signup_form_success' | t }}</p>
          {%- endif -%}
        {% endform %}
      </div>
    </main>
  </body>
</html>

<style>
  .password { display: flex; align-items: center; min-height: 100vh; padding-block: var(--space-6); }
  .password__inner { text-align: center; max-width: 520px; margin-inline: auto; display: flex; flex-direction: column; gap: var(--space-3); align-items: center; }
  .password__inner img { width: 160px; height: auto; }
  .password__wordmark { font-size: 32px; }
  .password__heading { margin: var(--space-3) 0 var(--space-4); }
</style>
